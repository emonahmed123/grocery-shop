# Backend server URL (routes live under /api). Used only on the Next.js server
# (server actions and proxy); no NEXT_PUBLIC_ prefix, so it never reaches the browser.
BACKEND_URL=https://grocery-store-server-orpin.vercel.app

# imgbb image hosting key (https://api.imgbb.com); server only, never NEXT_PUBLIC_
IMGBB_API_KEY=
